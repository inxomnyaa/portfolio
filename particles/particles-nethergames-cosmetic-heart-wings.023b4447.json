{"format_version": "1.10.0", "particle_effect": {"description": {"identifier": "cosmetic:heart_wings", "basic_render_parameters": {"material": "particles_blend", "texture": "textures/particle/particles"}}, "events": {"respawn_emitter": {"particle_effect": {"effect": "cosmetic:heart_wings", "type": "emitter_bound"}}}, "components": {"minecraft:emitter_initialization": {"creation_expression": "v.mirror=-1;v.max_rot=v.mirror*25;v.rot_offset=v.max_rot-(v.mirror*5);v.size=0.5;v.z_offset=4.25;v.y_offset=0;", "per_update_expression": "v.rot=math.sin(v.emitter_age*360)*v.max_rot;"}, "minecraft:emitter_local_space": {"position": true, "rotation": true}, "minecraft:emitter_rate_instant": {"num_particles": 2}, "minecraft:emitter_lifetime_once": {"active_time": 10}, "minecraft:emitter_lifetime_events": {"expiration_event": "respawn_emitter"}, "minecraft:emitter_shape_point": {}, "minecraft:particle_lifetime_expression": {"max_lifetime": 11}, "minecraft:particle_motion_parametric": {"relative_position": ["math.cos(v.rot+v.rot_offset)*v.size*v.mirror", "-v.size-v.y_offset", "-math.sin(v.rot+v.rot_offset)*v.size+(v.z_offset/16)"], "direction": ["math.sin(v.rot+v.rot_offset)*v.size", "v.mirror=v.mirror*-1;return 0;", "-math.cos(v.rot+v.rot_offset)*v.size*v.mirror"]}, "minecraft:particle_appearance_billboard": {"size": ["v.size", "v.size"], "facing_camera_mode": "direction_z", "uv": {"texture_width": 16, "texture_height": 16, "uv": [1, 5], "uv_size": [-1, 1]}}}}}